<%- include('partials/header', { title: '访客申请', hideNav: true }) %>

<section class="hero">
  <img src="/images/school-logo.jpg" alt="学校校徽" class="hero-logo">
  <div>
    <p class="eyebrow">免登录申请入口</p>
    <h1>提交校园访客申请</h1>
    <p>填写申请人、访客和入校时间。提交后系统生成专属二维码，可用于查看审批进度和门卫核验。</p>
  </div>
</section>

<form class="card form-grid" method="post" action="/applications" id="application-form">
  <label>
    申请人所在部门
    <select name="department_id" id="department-select" required>
      <option value="">请选择部门</option>
      <% departments.forEach(dept => { %>
        <option value="<%= dept.id %>"><%= dept.name %></option>
      <% }) %>
    </select>
  </label>
  <label>
    是否需要部门负责人审批
    <select name="requires_department_approval" id="approval-required-select" required>
      <option value="0">不需要，直接提交保卫处审批</option>
      <option value="1">需要，先提交部门负责人审批</option>
    </select>
  </label>
  <label class="span-2 hidden" id="department-approver-field">
    部门负责人审批人
    <select name="department_approver_id" id="department-approver-select">
      <option value="">请先选择申请人所在部门</option>
    </select>
    <small class="hint" id="department-approver-hint">仅显示该部门已启用且具有审批权限的部门账号姓名。</small>
  </label>
  <label>
    申请人姓名
    <input name="applicant_name" required maxlength="50">
  </label>
  <label>
    申请人联系电话
    <input name="applicant_phone" required maxlength="30">
  </label>
  <label>
    访客姓名
    <input name="visitor_name" required maxlength="50">
  </label>
  <label>
    访客性别
    <select name="visitor_gender" required>
      <option value="男">男</option>
      <option value="女">女</option>
      <option value="其他">其他</option>
    </select>
  </label>
  <label>
    访客联系电话
    <input name="visitor_phone" required maxlength="30">
  </label>
  <label>
    车牌号（可选）
    <input name="license_plate" maxlength="30" placeholder="无车辆可不填">
  </label>
  <label>
    开始时间
    <input type="datetime-local" name="visit_start" required>
  </label>
  <label>
    结束时间
    <input type="datetime-local" name="visit_end" required>
  </label>
  <label class="span-2">
    入校事由
    <textarea name="reason" required maxlength="500" rows="4"></textarea>
  </label>
  <div class="span-2 actions">
    <button type="submit">提交申请并生成二维码</button>
  </div>
</form>

<script>
  const departmentApprovers = <%- JSON.stringify(departmentApprovers || []) %>;
  const departmentSelect = document.getElementById('department-select');
  const approvalRequiredSelect = document.getElementById('approval-required-select');
  const approverField = document.getElementById('department-approver-field');
  const approverSelect = document.getElementById('department-approver-select');
  const approverHint = document.getElementById('department-approver-hint');
  const form = document.getElementById('application-form');

  function renderApproverOptions() {
    const needsApproval = approvalRequiredSelect.value === '1';
    const departmentId = departmentSelect.value;
    approverField.classList.toggle('hidden', !needsApproval);
    approverSelect.required = needsApproval;

    if (!needsApproval) {
      approverSelect.innerHTML = '<option value="">无需选择部门负责人</option>';
      approverSelect.value = '';
      return;
    }

    if (!departmentId) {
      approverSelect.innerHTML = '<option value="">请先选择申请人所在部门</option>';
      approverHint.textContent = '选择部门后，系统会显示该部门具有审批权限的负责人。';
      return;
    }

    const options = departmentApprovers.filter((user) => String(user.department_id) === String(departmentId));
    if (options.length === 0) {
      approverSelect.innerHTML = '<option value="">该部门暂无可选审批负责人</option>';
      approverHint.textContent = '请联系管理员为该部门账号设置审批权限，或改选“不需要”后由保卫处指定。';
      return;
    }

    approverSelect.innerHTML = '<option value="">请选择部门负责人审批人</option>' + options.map((user) => (
      `<option value="${user.id}">${user.real_name}</option>`
    )).join('');
    approverHint.textContent = '仅显示该部门已启用且具有审批权限的部门账号姓名。';
  }

  departmentSelect.addEventListener('change', renderApproverOptions);
  approvalRequiredSelect.addEventListener('change', renderApproverOptions);
  form.addEventListener('submit', (event) => {
    if (approvalRequiredSelect.value === '1' && !approverSelect.value) {
      event.preventDefault();
      alert('请选择部门负责人审批人');
    }
  });

  renderApproverOptions();
</script>

<%- include('partials/footer') %>
