<%- include('partials/header', { title: '修改密码' }) %>

<form class="card login-card" method="post" action="/change-password">
  <div class="login-logo-wrap">
    <img src="/images/school-logo.jpg" alt="学校校徽" class="login-logo">
  </div>
  <h1>修改密码</h1>
  <p class="muted">当前账号：<%= currentUser.realName %>（<%= roleLabels[currentUser.role] || currentUser.role %>）</p>
  <label>
    原密码
    <input name="old_password" type="password" required>
  </label>
  <label>
    新密码
    <input name="new_password" type="password" required minlength="6">
  </label>
  <label>
    确认新密码
    <input name="confirm_password" type="password" required minlength="6">
  </label>
  <button type="submit">确认修改</button>
</form>

<%- include('partials/footer') %>
