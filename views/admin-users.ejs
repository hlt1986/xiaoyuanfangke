<%- include('partials/header', { title: '账号管理' }) %>

<h1>账号管理</h1>
<p class="muted">除系统管理员外，保卫处账号和部门账号都必须绑定具体部门，并可设置是否具有审批权限。</p>

<form class="card form-grid" method="post" action="/admin/users">
  <label>用户名<input name="username" required maxlength="50"></label>
  <label>姓名<input name="real_name" required maxlength="50"></label>
  <label>密码<input name="password" type="password" required></label>
  <label>
    角色
    <select name="role" class="role-select">
      <option value="DEPARTMENT">部门账号</option>
      <option value="SECURITY">保卫处账号</option>
      <option value="ADMIN">系统管理员</option>
    </select>
  </label>
  <label>
    所属部门
    <select name="department_id">
      <option value="">系统管理员可不选</option>
      <% departments.forEach(dept => { %>
        <option value="<%= dept.id %>"><%= dept.name %></option>
      <% }) %>
    </select>
  </label>
  <label class="check-row"><input type="checkbox" name="can_approve" checked> 具有审批权限</label>
  <label class="check-row"><input type="checkbox" name="enabled" checked> 启用账号</label>
  <div class="actions"><button type="submit">新增账号</button></div>
</form>

<section class="card">
  <div class="section-title">
    <div>
      <h2>账号列表</h2>
      <p class="muted">可按角色和所属部门筛选账号。</p>
    </div>
  </div>
  <form class="filter-form" method="get" action="/admin/users">
    <label>
      角色
      <select name="role">
        <option value="" <%= !filters.role ? 'selected' : '' %>>全部角色</option>
        <option value="ADMIN" <%= filters.role === 'ADMIN' ? 'selected' : '' %>>系统管理员</option>
        <option value="SECURITY" <%= filters.role === 'SECURITY' ? 'selected' : '' %>>保卫处账号</option>
        <option value="DEPARTMENT" <%= filters.role === 'DEPARTMENT' ? 'selected' : '' %>>部门账号</option>
      </select>
    </label>
    <label>
      所属部门
      <select name="department_id">
        <option value="" <%= !filters.department_id ? 'selected' : '' %>>全部部门</option>
        <option value="NONE" <%= filters.department_id === 'NONE' ? 'selected' : '' %>>未绑定部门</option>
        <% departments.forEach(dept => { %>
          <option value="<%= dept.id %>" <%= String(filters.department_id) === String(dept.id) ? 'selected' : '' %>><%= dept.name %></option>
        <% }) %>
      </select>
    </label>
    <div class="filter-actions">
      <button type="submit">筛选</button>
      <a class="button ghost" href="/admin/users">重置</a>
    </div>
  </form>

  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>用户名</th>
        <th>姓名</th>
        <th>角色</th>
        <th>所属部门</th>
        <th>审批权限</th>
        <th>启用</th>
        <th>重置密码</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(user => { %>
        <tr>
          <form method="post" action="/admin/users/<%= user.id %>">
            <td><%= user.id %></td>
            <td><%= user.username %></td>
            <td><input name="real_name" value="<%= user.real_name %>" required></td>
            <td>
              <select name="role">
                <option value="DEPARTMENT" <%= user.role === 'DEPARTMENT' ? 'selected' : '' %>>部门账号</option>
                <option value="SECURITY" <%= user.role === 'SECURITY' ? 'selected' : '' %>>保卫处账号</option>
                <option value="ADMIN" <%= user.role === 'ADMIN' ? 'selected' : '' %>>系统管理员</option>
              </select>
            </td>
            <td>
              <select name="department_id">
                <option value="">系统管理员可不选</option>
                <% departments.forEach(dept => { %>
                  <option value="<%= dept.id %>" <%= Number(user.department_id) === Number(dept.id) ? 'selected' : '' %>><%= dept.name %></option>
                <% }) %>
              </select>
            </td>
            <td><input type="checkbox" name="can_approve" <%= user.can_approve ? 'checked' : '' %>></td>
            <td><input type="checkbox" name="enabled" <%= user.enabled ? 'checked' : '' %>></td>
            <td><input name="password" type="password" placeholder="留空不修改"></td>
            <td>
              <button type="submit">保存</button>
          </form>
              <form class="inline" method="post" action="/admin/users/<%= user.id %>/delete" onsubmit="return confirm('确认删除该账号？')">
                <button class="danger" type="submit">删除</button>
              </form>
            </td>
        </tr>
      <% }) %>
      <% if (users.length === 0) { %>
        <tr><td colspan="9" class="empty">当前筛选条件下暂无账号</td></tr>
      <% } %>
    </tbody>
  </table>
</section>

<%- include('partials/footer') %>
