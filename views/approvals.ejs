<%- include('partials/header', { title: '审批管理' }) %>

<div class="section-title">
  <h1>访客审批</h1>
  <div class="tabs">
    <a class="<%= status === 'PENDING' ? 'active' : '' %>" href="/approvals?status=PENDING">待审批</a>
    <a class="<%= status === 'APPROVED' ? 'active' : '' %>" href="/approvals?status=APPROVED">已通过</a>
    <a class="<%= status === 'REJECTED' ? 'active' : '' %>" href="/approvals?status=REJECTED">已打回</a>
    <a class="<%= status === 'ALL' ? 'active' : '' %>" href="/approvals?status=ALL">全部</a>
  </div>
</div>

<section class="card">
  <table>
    <thead>
      <tr>
        <th>访客</th>
        <th>申请人/部门</th>
        <th>入校时间</th>
        <th>状态</th>
        <th>事由</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% applications.forEach(item => { %>
        <tr>
          <td>
            <a href="/applications/<%= item.token %>"><%= item.visitor_name %></a><br>
            <small><%= item.visitor_phone %> / <%= item.license_plate || '无车牌' %></small>
          </td>
          <td><%= item.applicant_name %><br><small><%= item.department_name %></small></td>
          <td><%= dayjs(item.visit_start).format('YYYY-MM-DD HH:mm') %><br><small>至 <%= dayjs(item.visit_end).format('YYYY-MM-DD HH:mm') %></small></td>
          <td><span class="status <%= item.status.toLowerCase() %>"><%= item.status %></span></td>
          <td class="reason-cell"><%= item.reason %></td>
          <td>
            <% if (item.status === 'PENDING') { %>
              <form class="inline" method="post" action="/approvals/<%= item.id %>/approve">
                <button type="submit">通过</button>
              </form>
              <form class="reject-form" method="post" action="/approvals/<%= item.id %>/reject">
                <input name="reject_reason" placeholder="打回原因">
                <button class="danger" type="submit">打回</button>
              </form>
            <% } else { %>
              <small>审批人：<%= item.approver_name || '-' %></small>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (applications.length === 0) { %>
        <tr><td colspan="6" class="empty">暂无记录</td></tr>
      <% } %>
    </tbody>
  </table>
</section>

<%- include('partials/footer') %>
