<%- include('partials/header', { title: '审批查看' }) %>

<div class="section-title">
  <div>
    <h1>访客审批</h1>
    <% if (currentUser.role === 'DEPARTMENT') { %>
      <p class="muted">当前仅显示 <%= currentUser.departmentName || '本部门' %> 的申请；可查看本部门全部审批记录。</p>
    <% } else { %>
      <p class="muted">保卫处和管理员可查看全校申请；如发现申请需要部门负责人审批，可指定本部门审批人并转回部门审批。</p>
    <% } %>
  </div>
  <div class="tabs">
    <a class="<%= status === 'ALL' ? 'active' : '' %>" href="/approvals?status=ALL">全部</a>
    <a class="<%= status === 'DEPT_PENDING' ? 'active' : '' %>" href="/approvals?status=DEPT_PENDING">待部门审批</a>
    <a class="<%= status === 'SECURITY_PENDING' ? 'active' : '' %>" href="/approvals?status=SECURITY_PENDING">待保卫处审批</a>
    <a class="<%= status === 'APPROVED' ? 'active' : '' %>" href="/approvals?status=APPROVED">已通过</a>
    <a class="<%= status === 'REJECTED' ? 'active' : '' %>" href="/approvals?status=REJECTED">已打回</a>
  </div>
</div>

<section class="card">
  <table>
    <thead>
      <tr>
        <th>访客</th>
        <th>申请人/部门</th>
        <th>入校时间</th>
        <th>状态</th>
        <th>审批流</th>
        <th>事由</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% applications.forEach(item => { %>
        <% const canDeptAct = item.status === 'DEPT_PENDING' && (currentUser.role === 'ADMIN' || (currentUser.role === 'DEPARTMENT' && currentUser.canApprove && Number(currentUser.departmentId) === Number(item.department_id))); %>
        <% const canSecAct = item.status === 'SECURITY_PENDING' && (currentUser.role === 'ADMIN' || (currentUser.role === 'SECURITY' && currentUser.canApprove)); %>
        <% const sameDeptApprovers = departmentApprovers.filter(user => Number(user.department_id) === Number(item.department_id)); %>
        <tr>
          <td>
            <a href="/applications/<%= item.token %>"><%= item.visitor_name %></a><br>
            <small><%= item.visitor_phone %> / <%= item.license_plate || '无车牌' %></small>
          </td>
          <td><%= item.applicant_name %><br><small><%= item.department_name %></small></td>
          <td><%= dayjs(item.visit_start).format('YYYY-MM-DD HH:mm') %><br><small>至 <%= dayjs(item.visit_end).format('YYYY-MM-DD HH:mm') %></small></td>
          <td><span class="status <%= item.status.toLowerCase().replace('_', '-') %>"><%= statusLabels[item.status] || item.status %></span></td>
          <td>
            <% if (item.requires_department_approval) { %>
              <small>部门：<%= item.department_approver_name || '待审批' %></small><br>
              <% if (item.assigned_department_approver_name) { %>
                <small>指定给：<%= item.assigned_department_approver_name %></small><br>
              <% } %>
            <% } else { %>
              <small>部门：无需审批</small><br>
            <% } %>
            <small>保卫处：<%= item.security_approver_name || '待审批' %></small>
          </td>
          <td class="reason-cell"><%= item.reason %></td>
          <td>
            <% if (canDeptAct || canSecAct) { %>
              <form class="inline" method="post" action="/approvals/<%= item.id %>/approve">
                <button type="submit">通过</button>
              </form>
              <form class="reject-form" method="post" action="/approvals/<%= item.id %>/reject">
                <input name="reject_reason" placeholder="打回原因">
                <button class="danger" type="submit">打回</button>
              </form>
              <% if (canSecAct) { %>
                <% if (sameDeptApprovers.length > 0) { %>
                  <form class="assign-form" method="post" action="/approvals/<%= item.id %>/assign-department">
                    <select name="department_approver_id" required>
                      <option value="">指定部门审批人</option>
                      <% sameDeptApprovers.forEach(user => { %>
                        <option value="<%= user.id %>"><%= user.real_name %>（<%= user.department_name %>）</option>
                      <% }) %>
                    </select>
                    <button class="warning" type="submit">转部门审批</button>
                  </form>
                <% } else { %>
                  <small>本部门暂无可指定审批人</small>
                <% } %>
              <% } %>
            <% } else { %>
              <small><%= item.approver_name ? `最终审批：${item.approver_name}` : '无可操作项' %></small>
            <% } %>
          </td>
        </tr>
      <% }) %>
      <% if (applications.length === 0) { %>
        <tr><td colspan="7" class="empty">暂无记录</td></tr>
      <% } %>
    </tbody>
  </table>
</section>

<%- include('partials/footer') %>
